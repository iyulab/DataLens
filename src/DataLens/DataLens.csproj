<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>DataLens</PackageId>
    <Description>Exploratory data analysis engine for CSV/Excel datasets. Produces JSON analysis results including profiling, descriptive statistics, correlation, regression, clustering, outlier detection, PCA, and feature importance.</Description>
    <PackageTags>eda;data-analysis;statistics;csv;profiling;correlation;clustering</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FilePrepper" />
    <PackageReference Include="UInsight" />
    <!-- Security: lift FilePrepper→EPPlus's transitive System.Security.Cryptography.Pkcs and .Xml
         (10.0.10) to 10.0.13, past the advisories fixed there (Pkcs: GHSA-846f-f764-76mx,
         GHSA-2fmv-rv2c-59x7; Xml: GHSA-7hqp-7c5m-4vq6). Direct references so the fixed floor ships
         in this package's own graph; drop once FilePrepper's own dependency floor reaches 10.0.13. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DataLens.Tests" />
  </ItemGroup>

</Project>
