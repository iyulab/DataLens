<Project>

  <PropertyGroup>
    <Version>0.14.2</Version>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- NuGet 공통 메타데이터 -->
    <Authors>iyulab</Authors>
    <Company>iyulab</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/iyulab/DataLens</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- 기본적으로 NuGet 배포 비활성화 -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- /src 하위 프로젝트만 NuGet 배포 대상 -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('src'))">
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- NuGet security audit.
       Auditing itself is already on by default (NuGetAudit=true, and
       NuGetAuditMode defaults to "all" for net10.0+), but by default its
       findings are warnings that nothing acts on. This makes them errors in
       the dedicated audit pipeline only, so a newly published advisory fails
       CI loudly without blocking local builds and unrelated bug fixes.
       Pattern taken from the NuGet documentation ("Running NuGet Audit in CI").
       CI runs: dotnet restore -p:AuditPipeline=true -->
  <PropertyGroup>
    <NuGetAuditCodes>NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</NuGetAuditCodes>
    <WarningsAsErrors Condition=" '$(AuditPipeline)' == 'true' ">$(WarningsAsErrors);$(NuGetAuditCodes)</WarningsAsErrors>
    <WarningsNotAsErrors Condition=" '$(AuditPipeline)' != 'true' ">$(WarningsNotAsErrors);$(NuGetAuditCodes)</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
