<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core dependencies -->
    <PackageVersion Include="FilePrepper" Version="0.12.0" />
    <PackageVersion Include="UInsight" Version="0.36.2" />

    <!-- CLI dependencies -->
    <PackageVersion Include="System.CommandLine" Version="3.0.0-preview.7.26381.103" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />

    <!-- Test dependencies -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
