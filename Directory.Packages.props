<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core dependencies -->
    <PackageVersion Include="FilePrepper" Version="0.7.4" />
    <!-- Security override for FilePrepper→EPPlus's transitive dependency — see DataLens.csproj -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <PackageVersion Include="UInsight" Version="0.14.0" />

    <!-- CLI dependencies -->
    <PackageVersion Include="System.CommandLine" Version="3.0.0-preview.7.26381.103" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />

    <!-- Test dependencies -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
